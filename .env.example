# Copy into your deployment secret manager. Never commit populated files.
DATABASE_URL=postgresql+psycopg://novatrack:CHANGE_ME@postgres:5432/novatrack
OIDC_ISSUER=https://sso.example.com/application/o/novatrack
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
APP_BASE_URL=https://tracking.example.com
# Generate at least 32 random bytes, e.g. python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_BYTES
TRACK17_API_KEY=CHANGE_ME
TZ=UTC
LOG_LEVEL=INFO
# Explicit proxy IP/CIDR list only, never * on a directly reachable service.
TRUSTED_PROXY_IPS=127.0.0.1
# Optional comma-separated OIDC subject identifiers (not emails). Restrict access at IdP too.
ALLOWED_OIDC_SUBJECTS=
WORKER_POLL_SECONDS=5
# In UI enter this VARIABLE NAME, not its value. Add one variable per receiver.
NOVATRACK_WEBHOOK_SECRET_PRIMARY=CHANGE_ME_TO_A_RANDOM_SHARED_SECRET
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
# Compose standalone PostgreSQL password; URL-encode it in DATABASE_URL if necessary.
POSTGRES_PASSWORD=CHANGE_ME
